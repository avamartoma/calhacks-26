{
  "name": "iteration1-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime:install": "npm install --prefix .office/runtime --no-save --package-lock=false @openai/codex@0.156.1",
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs --production",
    "dev:web": "VITE_WEB=1 vite --port 4317 --strictPort",
    "build:web": "VITE_WEB=1 vite build --base /app/ --outDir share/public/app --emptyOutDir",
    "test": "node --test tests/*.test.mjs",
    "demo:team": "node scripts/team-preview.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth0/auth0-react": "^2.28.2",
    "@cursor/sdk": "^1.0.40",
    "@fontsource/urbanist": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chokidar": "^6.0.0",
    "convex": "^1.48.0",
    "e2b": "^2.59.0",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
